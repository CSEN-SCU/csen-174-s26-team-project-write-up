# Extension defaults are currently hardcoded in `src/sidepanel/sidepanel.js` and `src/content/docs.js`.
# These vars are optional placeholders for local configuration consistency.
# Shared URLs live in root `.env.example`:
# - APP_API_BASE_URL
# - COACHING_API_BASE_URL
# - WEBAPP_BASE_URL
#
# Webapp → extension Firebase token bridge (see `webapp/.env.example`):
# - VITE_EXTENSION_ID must match this extension's ID from chrome://extensions (Developer mode).
