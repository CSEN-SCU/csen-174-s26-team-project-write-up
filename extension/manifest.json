{
  "manifest_version": 3,
  "name": "Write Up",
  "version": "0.1.0",
  "description": "Learning-first writing feedback in Chrome side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:5173/*",
      "http://localhost:5173/*",
      "https://csen-174-s26-team-project-write-up.vercel.app/*"
    ]
  },
  "host_permissions": [
    "http://127.0.0.1:5050/*",
    "http://localhost:5050/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "https://csen-174-s26-team-project-write-up.vercel.app/*",
    "https://docs.google.com/*"
  ],
  "action": { "default_title": "Open Write Up side panel" },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "https://csen-174-s26-team-project-write-up.vercel.app/*"
      ],
      "js": ["src/content/landing.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": [
        "src/lib/api-headers.js",
        "src/lib/coach-defaults.js",
        "src/sidepanel/persist-feedback.js",
        "src/content/docs.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "src/sidepanel/sidepanel.html" }
}
