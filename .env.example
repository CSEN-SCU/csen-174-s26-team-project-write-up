# Global/shared env example for local dev.
# Copy relevant values into each section's own `.env` file as needed.

# -------- Shared Local Ports --------
APP_API_PORT=5050
COACHING_API_PORT=8787
WEBAPP_PORT=5173

# -------- Shared Local Base URLs --------
APP_API_BASE_URL=http://127.0.0.1:5050
COACHING_API_BASE_URL=http://127.0.0.1:8787
# Shared secret: app-api sends it to coaching-api; coaching-api rejects requests without a match. Required in all environments.
COACHING_INTERNAL_SECRET=change-me-to-a-long-random-string
WEBAPP_BASE_URL=http://127.0.0.1:5173
# Production: set to your deployed webapp URL (scheme + host, no path) so app-api CORS allows the browser; e.g. https://csen-174-s26-team-project-write-up.vercel.app

# Optional: comma-separated allowed browser origins for app-api CORS (see `backend/app-api/.env.example`).
# When unset, app-api derives origins from WEBAPP_BASE_URL plus Google Docs and local Vite URLs in dev/test.
# For Vercel preview URLs in addition to WEBAPP_BASE_URL, use APP_EXTRA_CORS_ORIGINS (comma-separated).
# APP_CORS_ORIGINS=
# APP_EXTRA_CORS_ORIGINS=

# -------- Shared LLM/API Keys --------
# Used by `backend/coaching-api`
# Optional: abort each provider chat/completions request after this many ms (default 90000). Prevents a hung LLM from blocking /coach indefinitely.
# COACH_LLM_HTTP_TIMEOUT_MS=90000
OPENAI_API_KEY=
GROQ_API_KEY=

# -------- Shared OAuth/Firebase --------
# Used by `backend/app-api`
# Option A (preferred for CI): raw service-account JSON content
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B (easy local dev): local path to service-account JSON file
FIREBASE_CREDENTIALS_PATH=./backend/app-api/firebase/service-account.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5050/auth/google/callback

# -------- Environment label --------
# One of: dev (default) / staging / prod / test
# Drives env-scoped Firebase secret lookup and gates dev-only shortcuts in backend/app-api.
APP_ENV=dev

# Dev-only: skip Firebase ID-token verification so teammates can call protected
# routes with `X-Debug-User: <uid>`. Refuses to activate unless APP_ENV is dev or test.
# Use 1 for local Chrome extension / Google Docs without web sign-in; leave unset or 0 in prod.
# app-api also setdefaults APP_AUTH_BYPASS, APP_LOCAL_DEV_STORE, and COACHING_INTERNAL_SECRET in dev/test.
APP_AUTH_BYPASS=1

# Local JSON documents store when Firestore is unavailable (auto-set in dev via apply_dev_defaults).
# APP_LOCAL_DEV_STORE=1

# Optional: app-api coach proxy emits one JSON INFO line per upstream success ([coach-proxy]); use with COACH_LOG_LLM + same X-Request-Id.
# APP_COACH_PROXY_LOG=1

# Optional: same values as the Firebase **Web app** config (Project settings). Lets app-api serve
# GET /auth/client-config to the extension without duplicating secrets in the extension package.
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_PROJECT_ID=
# FIREBASE_WEB_STORAGE_BUCKET=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_MEASUREMENT_ID=

# -------- Per-environment Firebase secrets (optional) --------
# When set, these win over the unsuffixed FIREBASE_* vars above.
# In CI or hosted envs, define secrets named with the env suffix (e.g. ..._DEV).
# FIREBASE_SERVICE_ACCOUNT_JSON_DEV=
# FIREBASE_SERVICE_ACCOUNT_JSON_STAGING=
# FIREBASE_SERVICE_ACCOUNT_JSON_PROD=
# FIREBASE_CREDENTIALS_PATH_DEV=
# FIREBASE_CREDENTIALS_PATH_STAGING=
# FIREBASE_CREDENTIALS_PATH_PROD=
