VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Deployed webapp (Vercel, etc.): absolute base URL of app-api, no trailing slash. Required whenever
# the UI is not served by Vite (no dev proxy). Example: https://your-app-api.onrender.com
# VITE_APP_API_BASE_URL=

# Chrome extension ID (from chrome://extensions, Developer mode) so the webapp can push ID tokens to the extension.
# VITE_EXTENSION_ID=

# Optional local dev: set to a uid string when app-api runs with APP_AUTH_BYPASS=1 (see root .env.example).
# VITE_DEBUG_APP_USER=local-web-user
