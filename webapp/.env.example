VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Dev vs prod (see docs/api-contracts.md) ---
# Local: leave VITE_APP_API_BASE_URL unset; Vite proxies /api, /coach, /auth to app-api :5050.
# Production: set to your deployed app-api URL (no trailing slash), e.g. https://your-app-api.onrender.com
# VITE_APP_API_BASE_URL=

# Firebase web app config (required for /write editor sign-in in prod; mirror FIREBASE_WEB_* on app-api).

# Chrome extension ID (from chrome://extensions, Developer mode) so the webapp can push ID tokens to the extension.
# VITE_EXTENSION_ID=

# Optional local dev: set to a uid string when app-api runs with APP_AUTH_BYPASS=1 (see root .env.example).
# VITE_DEBUG_APP_USER=local-web-user
