VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- app-api connection ---
# The webapp tries these URLs in order on every request. If the first one fails
# (network error or HTTP 5xx) it falls through to the next. 4xx is never retried.
#
# Local dev: leave both unset; Vite proxies /api, /coach, /auth to app-api :5050.
# Production: set VITE_APP_API_PROD_URL to the deployed app-api (no trailing slash).
#             VITE_APP_API_DEV_URL is optional — set it to a backup deployment or
#             leave it unset. Do NOT set it to localhost in a deployed build,
#             since that would resolve to the visitor's own machine.
# VITE_APP_API_PROD_URL=https://write-up-app-api.vercel.app
# VITE_APP_API_DEV_URL=

# Legacy single-URL var (still honored as a final fallback so existing setups keep working).
# VITE_APP_API_BASE_URL=

# Firebase web app config (required for /write editor sign-in in prod; mirror FIREBASE_WEB_* on app-api).

# Chrome extension ID (from chrome://extensions, Developer mode) so the webapp can push ID tokens to the extension.
# VITE_EXTENSION_ID=

# Optional local dev: set to a uid string when app-api runs with APP_AUTH_BYPASS=1 (see root .env.example).
# VITE_DEBUG_APP_USER=local-web-user
