# Shared secret — must match COACHING_INTERNAL_SECRET set on app-api
COACHING_INTERNAL_SECRET=change-me-to-a-long-random-string

# LLM API keys (optional — heuristics + mechanics work without them)
GROQ_API_KEY=
OPENAI_API_KEY=

# Production logging (no draft text is ever logged)
# COACH_LOG=1                  — one JSON summary line per /coach (counts only)
# COACH_DEBUG_MECHANICS=1      — verbose detector traces (local debugging only)
# COACH_LOG_LLM=1              — LLM request/response previews (see llm module)
