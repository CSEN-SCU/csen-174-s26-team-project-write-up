PORT=8787
COACH_LLM=auto
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
# Shared secrets live in root `.env.example`:
# - OPENAI_API_KEY
# - GROQ_API_KEY
# TF–IDF retrieval: chunks merged from full draft, tail window, and spelling-augmented query
RAG_TOP_K=8

# --- Google Docs / MCP (extension live: use_mcp + doc_id on POST /coach) ---
# Option A: OAuth access token, scope https://www.googleapis.com/auth/documents.readonly
# GOOGLE_DOCS_ACCESS_TOKEN=
# Option B: HTTP MCP bridge (POST { name, arguments }) — see docs/mcp-google-cloud-testing.md
# GOOGLE_DOCS_MCP_BRIDGE_URL=
# GOOGLE_DOCS_MCP_TOOL=google_docs.get_document_text
# GOOGLE_DOCS_MCP_AUTH_BEARER=

# Opt-in LLM I/O logging to stderr (JSON lines prefixed with [coach-llm]). Default: off.
# When requests come through app-api, logs include requestId (from X-Request-Id) for correlation with [coach-proxy] lines.
# COACH_LOG_LLM=1
# Preview length per message field (default 400, max 8000). Omit middle of long strings unless COACH_LOG_LLM_FULL=1.
# COACH_LOG_LLM_PREVIEW=400
# COACH_LOG_LLM_FULL=1
