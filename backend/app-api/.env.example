# Local dev server port (default 5050)
PORT=5050

# --- Firebase ---
# Local dev: path to your downloaded service account JSON file
FIREBASE_CREDENTIALS_PATH=service-account.json
# Vercel: paste the entire contents of service-account.json as a single-line JSON string
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# --- Coaching API ---
# Local dev: coaching-api runs on this address
COACHING_API_BASE_URL=http://127.0.0.1:8787
# Shared secret — must match COACHING_INTERNAL_SECRET set on coaching-api
COACHING_INTERNAL_SECRET=change-me-to-a-long-random-string

# --- CORS ---
# Origin of the deployed webapp (e.g. https://your-app.vercel.app)
# WEBAPP_BASE_URL=
# Additional allowed origins, comma-separated
# APP_EXTRA_CORS_ORIGINS=
