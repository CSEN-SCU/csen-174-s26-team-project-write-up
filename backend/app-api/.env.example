# Local-only app-api vars.
# Use root `.env.example` for shared values:
# - APP_API_PORT
# - FIREBASE_CREDENTIALS_PATH
# - COACHING_API_BASE_URL (Node coaching-api; app-api proxies /coach and /dismiss here)
PORT=5050
COACHING_API_BASE_URL=http://127.0.0.1:8787

# Comma-separated browser origins allowed to call app-api (overrides derived defaults).
# Example: https://app.example.com,https://staging.example.com,chrome-extension://YOUR_EXT_ID
# If unset, origins are derived from WEBAPP_BASE_URL (see root `.env.example`), Google Docs
# (content script), and in dev/test also http://127.0.0.1:5173 and http://localhost:5173.
# APP_CORS_ORIGINS=

# JSON access log per successful coach/dismiss upstream call (grep [coach-proxy]). Correlate with coaching-api via X-Request-Id.
# APP_COACH_PROXY_LOG=1

# Public Firebase web config (same as webapp VITE_FIREBASE_*). Enables GET /auth/client-config for extension alignment.
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_PROJECT_ID=
# FIREBASE_WEB_STORAGE_BUCKET=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_MEASUREMENT_ID=
